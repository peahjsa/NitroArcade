function hackerSetup(){
 attempts=0;
 const m=active.name.match(/^(One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten|Eleven|Twelve)-Digit/);
 const lengths={One:1,Two:2,Three:3,Four:4,Five:5,Six:6,Seven:7,Eight:8,Nine:9,Ten:10,Eleven:11,Twelve:12};
 const digits=m?lengths[m[1]]:0;
 const size=active.name==="Mega Cipher Terminal"?8:4;
 const len=digits||size;
 const letters=!digits;
 const chars=letters?"ABCDEFGHIJKLMNOPQRSTUVWXYZ":"0123456789";
 secret=Array.from({length:len},()=>chars[Math.floor(Math.random()*chars.length)]).join("");
 maxAttempts=digits?Math.min(35,5+digits*3):20;
 const area=document.getElementById("playArea");
 area.innerHTML=`
 <h2 style="color:#ff49d4">▰ SECURE PUZZLE TERMINAL ▰</h2>
 <p>Code length: <b>${len}</b> • Attempts: <b id="left">${maxAttempts}</b></p>
 <input id="guess" maxlength="${len}" placeholder="${letters?"ENTER LETTERS":"ENTER DIGITS"}" autocomplete="off">
 <p><button id="submitGuess">SUBMIT CODE</button> <button onclick="newCode()">NEW CODE</button></p>
 <p id="hint">Hint: ${letters?"Use uppercase letters A–Z.":"The code contains digits 0–9."}</p>
 <div id="history" style="white-space:pre-line;color:#b6c9f9"></div>`;
 const input=document.getElementById("guess");
 document.getElementById("submitGuess").onclick=()=>checkCode(len,letters);
 input.addEventListener("keydown",e=>{if(e.key==="Enter")checkCode(len,letters)});
 input.focus();
 document.getElementById("feedback").textContent="SYSTEM ONLINE — crack the secret!";
}
function newCode(){if(active)hackerSetup()}
function checkCode(len,letters){
 const input=document.getElementById("guess");
 const guess=input.value.trim().toUpperCase();
 const valid=letters?new RegExp("^[A-Z]{"+len+"}$"):new RegExp("^\\\d{"+len+"}$");
 if(!valid.test(guess)){document.getElementById("feedback").textContent="Enter exactly "+len+(letters?" letters!":" digits!");return}
 attempts++;
 document.getElementById("left").textContent=Math.max(0,maxAttempts-attempts);
 if(guess===secret){
 score+=100+(maxAttempts-attempts)*10;
 document.getElementById("feedback").textContent="ACCESS GRANTED! +"+score+" POINTS 🏆";
 document.getElementById("hint").textContent="You cracked it: "+secret;
 input.disabled=true;document.getElementById("submitGuess").disabled=true;return;
 }
 let clue="";
 if(!letters){
   let exact=0,correct=0;
   for(let i=0;i<len;i++){if(guess[i]===secret[i])exact++;if(secret.includes(guess[i]))correct++}
   clue=`Right digit, right place: ${exact}. Digits appearing in code: ${correct}.`;
 }else{
   let exact=0,present=0;
   for(let i=0;i<len;i++){if(guess[i]===secret[i])exact++}
   for(const ch of new Set(guess))if(secret.includes(ch))present++;
   clue=`Correct letter and position: ${exact}. Letters present: ${present}.`;
 }
 document.getElementById("hint").textContent=clue;
 const hist=document.getElementById("history");
 hist.textContent=(hist.textContent?hist.textContent+"\n":"")+"Attempt "+attempts+": "+guess;
 document.getElementById("feedback").textContent="ACCESS DENIED — try again!";
 if(attempts>=maxAttempts){
   document.getElementById("feedback").textContent="SYSTEM LOCKED — code was "+secret;
   input.disabled=true;document.getElementById("submitGuess").disabled=true;
 }
}
