function startBuilder(){let[c,x]=C(),s={money:500,build:[],tick:0};help('🏭 Click empty ground to build. Buildings generate credits. Create a thriving neon colony.');c.onclick=e=>{let r=c.getBoundingClientRect(),mx=(e.clientX-r.left)*960/r.width,my=(e.clientY-r.top)*540/r.height;if(my>180&&s.money>=100){s.build.push({x:mx,y:my,h:40+rand(s.build.length)*100});s.money-=100}};loop(()=>{s.tick++;if(s.tick%120===0)s.money+=s.build.length*15;bg3(x,'#0b2740','#102214');x.fillStyle='#173a2a';x.fillRect(0,180,960,360);for(let b of s.build){x.fillStyle='#202b48';x.fillRect(b.x-25,b.y-b.h,50,b.h);x.fillStyle='#00eaff';for(let yy=b.y-b.h+10;yy<b.y-8;yy+=18)x.fillRect(b.x-14,yy,8,8)}hud(`CREDITS ${s.money} • BUILDINGS ${s.build.length} • +${s.build.length*15}/cycle`)})}
function startSkill(){let[c,x]=C(),s={score:0,t:0,target:{x:480,y:270,r:35}};help('🎯 Click the moving neon target as many times as you can.');c.onclick=e=>{let r=c.getBoundingClientRect(),mx=(e.clientX-r.left)*960/r.width,my=(e.clientY-r.top)*540/r.height;if(Math.hypot(mx-s.target.x,my-s.target.y)<s.target.r){s.score++;s.target.x=70+Math.random()*820;s.target.y=70+Math.random()*400;s.target.r=Math.max(15,35-s.score*.5)}};loop(()=>{s.t++;bg3(x,'#071326','#250a35');s.target.x+=Math.sin(s.t/25)*1.5;s.target.y+=Math.cos(s.t/31)*1.2;x.strokeStyle='#00eaff';x.lineWidth=7;x.beginPath();x.arc(s.target.x,s.target.y,s.target.r,0,7);x.stroke();x.strokeStyle='#ff38c7';x.beginPath();x.arc(s.target.x,s.target.y,s.target.r*.55,0,7);x.stroke();hud(`HITS ${s.score} • TARGET SIZE ${Math.round(s.target.r)}`)})}


// Original synthesized arcade soundtrack — generated in the browser.
function tone(freq,dur,type="square",vol=.045,when=0){
 if(!audioCtx)return;
 const osc=audioCtx.createOscillator(),gain=audioCtx.createGain();
 osc.type=type;osc.frequency.setValueAtTime(freq,audioCtx.currentTime+when);
 gain.gain.setValueAtTime(.0001,audioCtx.currentTime+when);
 gain.gain.exponentialRampToValueAtTime(vol,audioCtx.currentTime+when+.015);
 gain.gain.exponentialRampToValueAtTime(.0001,audioCtx.currentTime+when+dur);
 osc.connect(gain);gain.connect(audioCtx.destination);
 osc.start(audioCtx.currentTime+when);osc.stop(audioCtx.currentTime+when+dur+.03);
}
function musicBar(){
 if(!musicOn||!audioCtx)return;
 // Original bright synthwave melody with bass and a kick/snare rhythm.
 const melody=[659,784,988,784,587,698,880,698,523,659,784,659,587,698,880,1047];
 const bass=[110,110,146.8,146.8,98,98,130.8,130.8];
 const n=step++%melody.length;
 tone(melody[n],.19,"sawtooth",.027);
 tone(bass[n%bass.length],.32,"triangle",.075);
 if(n%4===0){
   tone(65,.12,"sine",.16);
   tone(1800,.045,"square",.018,.12);
 }
 if(n%4===2)tone(240,.09,"triangle",.055);
}
async function toggleMusic(){
 if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();
 if(audioCtx.state==="suspended")await audioCtx.resume();
 musicOn=!musicOn;
 const btn=document.getElementById("musicBtn");
 if(musicOn){
   btn.textContent="🔊 ARCADE MUSIC: ON";
   musicBar();musicTimer=setInterval(musicBar,180);
 }else{
   btn.textContent="🎵 PLAY ARCADE MUSIC";
   clearInterval(musicTimer);
 }
}
